{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aida-fps-studio:project:1",
  "title": "AIDA project.json manifest inside a .aida container",
  "type": "object",
  "required": ["format", "version", "source", "source_size", "source_mtime_ns"],
  "properties": {
    "format": {"const": "aida-project"},
    "version": {"const": 1},
    "source": {"type": "string", "minLength": 1},
    "relative_source": {"type": "string"},
    "source_size": {"type": "integer", "minimum": 0},
    "source_mtime_ns": {"type": "integer", "minimum": 0},
    "target": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "overrides": {"type": "object", "additionalProperties": {"type": ["number", "null"], "exclusiveMinimum": 0}},
    "ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start_frame", "end_frame", "label"],
        "properties": {
          "start_frame": {"type": "integer", "minimum": 0},
          "end_frame": {"type": "integer", "minimum": 0},
          "label": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
